{
  "version": 1,
  "purpose": "Action vocabulary for the Minecraft AI controller.",
  "actions": {
    "forward": {"description": "Move forward", "default_ticks": 8},
    "back": {"description": "Move backward", "default_ticks": 8},
    "left": {"description": "Strafe left", "default_ticks": 8},
    "right": {"description": "Strafe right", "default_ticks": 8},
    "jump": {"description": "Jump once"},
    "stop": {"description": "Stop all movement"},
    "turn_left": {"description": "Turn left", "default_radians": 0.3},
    "turn_right": {"description": "Turn right", "default_radians": 0.3},
    "look_up": {"description": "Look upward", "default_radians": 0.2},
    "look_down": {"description": "Look downward", "default_radians": 0.2},
    "mine": {"description": "Mine the block at the crosshair", "max_distance": 5},
    "attack": {"description": "Attack the entity at the crosshair", "max_distance": 5}
